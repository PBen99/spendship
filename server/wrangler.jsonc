{
  "name": "spendship",
  "main": "src/index.ts",
  "compatibility_date": "2025-11-01",
  // One Worker serves both the PWA (static assets) and the API.
  "assets": {
    "directory": "../client/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "spendship",
      "database_id": "57a2c1a6-060b-4893-870c-c7725fab3d31"
    }
  ]
}
